{
  "listen": "0.0.0.0:8443",
  "handshake_timeout": "10s",
  "dial_timeout": "10s",
  "idle_timeout": "5m",
  "log_size": "0M",
  "log_file": "logs/server.log",
  "performance": {
    "mode": "interactive"
  },
  "obfs": {
    "provider": "none",
    "participation": 0
  },
  "udp": {
    "enabled": true,
    "idle_timeout": "2m",
    "max_datagram_size": 61440,
    "queue_packets": 256,
    "max_associations_per_user": 256,
    "max_destinations_per_association": 1024,
    "packets_per_second_per_user": 10000,
    "bytes_per_second_per_user": 67108864,
    "dns_cache_ttl": "30s",
    "dns_negative_ttl": "5s"
  },
  "users": [
    {
      "client_id": "demo-user",
      "secret": "REPLACE_WITH_BASE64URL_32_BYTE_SECRET",
      "status": "enabled",
      "max_connections": 4096,
      "allow_private": false
    }
  ]
}
