    "Addresses in China connect directly; everything else goes through the proxy." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於中國的位址直接連線，其餘流量經由代理。"
          }
        }
      }
    },
    "All traffic goes through the proxy. Domains are sent to the server without resolving them on the device." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有流量都經由代理。網域名稱不在裝置上解析，直接交給伺服器。"
          }
        }
      }
    },
    "Allow adding the VPN configuration to test latency." : {
